# Dependencies
node_modules/

# Build output
dist/

# Generated projections — always safe to delete, never source.
# See archaeology/decisions/0003-*.md for the cache/frozen distinction.
# .cuecraft/ also holds the downloaded Kokoro weights: pinned by
# kokoro-model.lock.json, reproducible from it, and never committed
# (decision:8). Deleting it fully resets the local model installation.
.cuecraft/
out/

# Scratch audio from `cuecraft speak` / `npm run speak`.
tmp/
# Repository root only, and deliberately not `*.wav`: a recursive rule would also
# swallow frozen narration assets wherever they eventually land (decision:3,
# dragon:2), and Git cannot re-add an ignored file without a fight. Generated
# narration is already covered by .cuecraft/, out/, and tmp/ above.
/*.wav

# Symbol tables written beside a film rendered to the repository root. A projection in
# exactly decision:1's sense — derived from the compilation, always safe to delete, never
# hand-edited (decision:66). Anchored, for /*.wav's reason.
/*.symbols.json

# Frozen narration assets are deliberately NOT ignored: once promoted, they
# are repository-managed source, not build output.

# Credentials and local environment
.env
.env.*
!.env.example

# Development instrumentation — observes Claude working here; not part of the
# build and not a cuecraft dependency. See archaeology/decisions/0007-*.md.
# Recordings are unredacted session evidence and must never be committed.
.witnessglass/
.claude/settings.local.json

# Editor / OS noise
.DS_Store
*.swp
.idea/
.vscode/
