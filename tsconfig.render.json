{
  // The composition is the one part of cuecraft Node never executes: Remotion's bundler
  // compiles it (decision:5). That buys it JSX, a DOM, and freedom from the type-stripping
  // constraints the rest of the source lives under — and costs it the right to be emitted.
  // `npm run typecheck` runs this config alongside the main one.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "sourceMap": false,
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "erasableSyntaxOnly": false,
    "types": ["node"]
  },
  "include": ["src/render/**/*.tsx", "src/render/**/*.ts", "src/compile/**/*.ts"]
}
