{
  "name": "cuecraft",
  "version": "0.0.0",
  "private": true,
  "description": "Compile narrated slide presentations from a YAML source into a 16:9 MP4",
  "license": "MIT",
  "author": "Henry Filgueiras",
  "type": "module",
  "bin": {
    "cuecraft": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.render.json",
    "test": "node --test \"src/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run test",
    "speak": "node src/cli.ts speak",
    "render": "node src/cli.ts render",
    "test:tts": "node --test \"src/**/*.live-test.ts\"",
    "test:render": "node --test \"src/**/*.render-test.ts\"",
    "bootstrap:tts": "./scripts/bootstrap-local-tts.sh",
    "compress:upload": "./scripts/compress-for-upload.sh"
  },
  "devDependencies": {
    "@types/d3-interpolate": "^3.0.4",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prettier": "^3.5.0",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.0",
    "@remotion/bundler": "^4.0.506",
    "@remotion/renderer": "^4.0.506",
    "d3-interpolate": "^3.0.1",
    "diff": "^9.0.0",
    "highlight.js": "^11.11.1",
    "kokoro-js": "1.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.506",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
